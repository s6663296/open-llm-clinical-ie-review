@inproceedings{10.1145/3787279.3787325,
author = {Alkhozae, Mona},
title = {AI-Powered Chatbots and Traditional Clinical Methods in Mental Health Assessment: A Comparative Review},
year = {2026},
isbn = {9798400721045},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3787279.3787325},
doi = {10.1145/3787279.3787325},
abstract = {AI-powered chatbots offer a novel approach for mental health assessment and provide accessible, scalable approaches that can help address several gaps in traditional clinical assessment tools and deliver the required healthcare services. This paper presents a review of AI chatbots strengths and limitations compared to traditional clinical assessment methods. We evaluate AI chatbot capabilities across domains, including scalability, diagnostic accuracy, user engagement, and ethical considerations. AI chatbots are promising tools for mental health assessment. The challenges include validating chatbot assessments, integrating chatbots into existing healthcare assessment systems, and building trust between individuals and clinicians. We highlight the recent research advances in the mental health assessment domain, the gaps we currently identify, and recommend development approaches that integrate the power of AI with clinicians’ experience to support and enhance mental healthcare services.},
booktitle = {Proceedings of the 2025 9th International Conference on Advances in Artificial Intelligence},
pages = {289–300},
numpages = {12},
keywords = {AI chatbots evolution, AI-powered chatbots, mental health assessment, traditional clinical methods},
location = {Manchester, United Kingdom},
series = {ICAAI '25}
}

