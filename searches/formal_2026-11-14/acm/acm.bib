@article{10.1145/3744660,
author = {Rodrigues, Tiago and Teixeira Lopes, Carla},
title = {Harnessing Large Language Models for Clinical Information Extraction: A Systematic Literature Review},
year = {2025},
issue_date = {October 2025},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {6},
number = {4},
url = {https://doi.org/10.1145/3744660},
doi = {10.1145/3744660},
abstract = {Electronic Health Records store extensive patient health data, playing a crucial role in healthcare management. Extracting information from these text-heavy records is difficult due to their domain-specific vocabulary, which challenges applying general-domain techniques. Recent advancements in Large Language Models (LLMs) and an increasing interest in the field have sparked considerable progress in solving Clinical Information Extraction (IE) tasks. We review these applications in Clinical IE, highlighting the most common tasks, most successful methods, and most used datasets and evaluation criteria. Examining 85 studies, we synthesize and organize the current research trends, highlighting common points between papers. The presence of LLMs can be felt in the most common tasks, with novel approaches being attempted and showing promising results. However, breakthroughs are still necessary in designing reliable end-to-end systems that can perform all the Clinical IE tasks within a single system.},
journal = {ACM Trans. Comput. Healthcare},
month = oct,
articleno = {47},
numpages = {35},
keywords = {Information Extraction, Large Language Models, BERT, Clinical Notes, Electronic Health Records}
}

@inbook{10.1145/3841905.3842002,
author = {Dong, Ningyu and Gan, Kezheng},
title = {Design of a System for Structured Extraction and Auxiliary Diagnosis of Clinical Medical Records Based on Large Language Models},
year = {2026},
isbn = {9798400723353},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3841905.3842002},
abstract = {Most clinical records are written for clinicians rather than for automated reuse. As a result, useful diagnostic information can be difficult to retrieve efficiently. We built an integrated large-language-model method to structure these records and support auxiliary diagnosis. Structural-consistency constraints keep the extracted representation stable. Graph-based reasoning and explainable vector modeling are then used to calculate diagnostic probabilities and produce interpretable outputs. We tested the method on 5,000 de-identified clinical records from the C-EMRs dataset collected at Huangshi Central Hospital in China. The F1 score for structured extraction was 94.6\%, and diagnostic accuracy was 89.8\%. The AUC reached 0.921. Critical-path coverage exceeded 70\%. In these experiments, using structural constraints together with graph-based reasoning improved diagnostic stability and interpretability in complex semantic settings. The method therefore has potential for clinical decision-support applications.},
booktitle = {Proceedings of the 5th International Conference on Biomedical and Intelligent Systems},
pages = {613–617},
numpages = {5}
}

@inproceedings{10.1145/3644116.3644136,
author = {Xu, Yiyang and Gao, Wenliang},
title = {Named Entity Recognition in Electronic Medical Records Based on Bidirectional Long Short-Term Memory-Conditional Random Field},
year = {2024},
isbn = {9798400708138},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3644116.3644136},
doi = {10.1145/3644116.3644136},
abstract = {In most hospitals in China, the actions of medical staff, patients' conditions, and treatment methods for diseases all need to be recorded in a system for easy management and viewing. This system is called electronic medical record(EMR). Due to the large number of medical institutions in China, EMR contains a large amount of valuable information. The purpose of this study is to use deep learning to automatically identify key words in EMR. This study uses a Bi-directional Long Short-Term Memory (BiLSTM) network to extract sequence information, and uses a Conditional Random Field (CRF) to solve the label mapping problem. An open-source dataset is used to train and test the model. In the experiment, we collected multiple experimental data and evaluated the model's performance. The results show that the model can be well applied to the entity recognition task in EMR.},
booktitle = {Proceedings of the 2023 4th International Symposium on Artificial Intelligence for Medicine Science},
pages = {101–105},
numpages = {5},
location = {Chengdu, China},
series = {ISAIMS '23}
}

@inproceedings{10.1145/3743093.3771004,
author = {Tang, Yi and Ye, Dengpan},
title = {BALANCE: A Fairness-Aware Framework for Privacy-Preserving Synthetic Clinical Text Generation},
year = {2025},
isbn = {9798400720055},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3743093.3771004},
doi = {10.1145/3743093.3771004},
abstract = {Electronic health-record narratives enable valuable data-driven clinical applications but raise acute risks of privacy leakage and demographic bias. We present Balance, the Bias-Aware, Leakage-avoidant ANonymized Clinical Engine, a fairness-aware clinical text synthesis framework that integrates group-aware entity auditing, fairness-aware k-anonymization, and few-shot LLM generation. On the MIMIC-III discharge-summary corpus, Balance reduces attacker re-identification accuracy, halves coverage gaps between sex and age cohorts, and preserves comparable semantic fidelity. Downstream models trained on Balance-generated corpora maintain or improve performance on clinical NER, readmission prediction, ICD-10 coding, and phenotyping. These results demonstrate that strong privacy protection and equitable representation can be achieved without compromising utility.},
booktitle = {Proceedings of the 7th ACM International Conference on Multimedia in Asia},
articleno = {58},
numpages = {7},
keywords = {Clinical Text Generation, Fairness in AI, Privacy Preservation, Text-based Multimedia, Large Language Models},
location = {Kuala Lumpur, Malaysia},
series = {MMAsia '25}
}

@inproceedings{10.1145/3688868.3689200,
author = {Chen, Yuxuan and Yang, Haoyan and Pan, Hengkai and Siddiqui, Fardeen and Verdone, Antonio and Zhang, Qingyang and Chopra, Sumit and Zhao, Chen and Shen, Yiqiu},
title = {BURExtract-Llama: An LLM for Clinical Concept Extraction in Breast Ultrasound Reports},
year = {2024},
isbn = {9798400711954},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3688868.3689200},
doi = {10.1145/3688868.3689200},
abstract = {Breast ultrasound plays a pivotal role in detecting and diagnosing breast abnormalities. Radiology reports summarize key findings from these examinations, highlighting lesion characteristics and malignancy assessments. However, extracting this critical information is challenging due to the unstructured nature of radiology reports, which often exhibit varied linguistic styles and inconsistent formatting. While proprietary LLMs like GPT-4 effectively retrieve information, they are costly and raise privacy concerns when handling protected health information. This study presents a pipeline for developing an in-house LLM to extract clinical information from these reports. We first utilize GPT-4 to create a small subset of labeled data, then fine-tune a Llama3-8B using this dataset. Evaluated on a subset of reports annotated by clinicians, the proposed model achieves an average F1 score of 84.6\%, which is on par with GPT-4. Our findings demonstrate that it is feasible to develop an in-house LLM that not only matches the performance of GPT-4 but also offers cost reductions and enhanced data privacy.},
booktitle = {Proceedings of the 1st International Workshop on Multimedia Computing for Health and Medicine},
pages = {53–58},
numpages = {6},
keywords = {breast ultrasound, clinical information extraction, fine-tuning, llm, radiology reports},
location = {Melbourne VIC, Australia},
series = {MCHM'24}
}

@inproceedings{10.1145/3721201.3725440,
author = {Li, Shenglin and Gong, Jiaqi and Ramirez Molina, Abel Andres},
title = {Approximate Knowledge Graphs: Privacy-Preserving Healthcare Data Synthesis via LLM-Driven approximation},
year = {2025},
isbn = {9798400715396},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3721201.3725440},
doi = {10.1145/3721201.3725440},
abstract = {This research presents a novel framework for generating privacy-preserving synthetic healthcare data by integrating Large Language Models (LLMs) and Knowledge Graphs (KGs). The method transforms raw Electronic Health Records (EHRs) into a structured KG using LLM-based entity extraction, then applies a calibrated approximation parameter ranging from 1 (highest approximation) to 10 (None approximation). Experimental results on a 20,000-patient dataset demonstrate that more aggressive approximation drastically reduces re-identification risk while retaining sufficient fidelity for downstream tasks, as evidenced by a linear classification model predicting tumor type (Benign vs. Malignant). Even moderate parameter settings (5–7) preserve much of the model's predictive accuracy while substantially mitigating privacy risks. This balance between privacy and data utility underscores the potential of a semi-automated, parameterized approach for generating synthetic EHR data that safeguards sensitive information yet remains clinically valuable. Future work will further refine the approximation strategy, incorporate more complex KG structures, and scale to diverse healthcare datasets.},
booktitle = {Proceedings of the ACM/IEEE International Conference on Connected Health: Applications, Systems and Engineering Technologies},
pages = {458–463},
numpages = {6},
keywords = {data anonymization, synthetic electronic health records, privacy-preserving data generation, large language models, knowledge graphs},
location = {New York, NY, USA},
series = {CHASE '25}
}

@inproceedings{10.1145/3708557.3716327,
author = {Jana, Sudeshna and Dasgupta, Tirthankar and Sinha, Manjira},
title = {A Data-Driven Approach to Predicting and Visualizing Disease Progression in Hospitalized Patients},
year = {2025},
isbn = {9798400714092},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3708557.3716327},
doi = {10.1145/3708557.3716327},
abstract = {Personalized, evidence-based patient care has become increasingly important, with a focus on understanding disease trajectories. Traditionally, disease progression was analyzed using structured data from Electronic Health Records (EHRs), but recent advances in Natural Language Processing (NLP) and Large Language Models (LLMs) now enable the extraction of insights from unstructured clinical notes. This paper presents DisTrajNet, a deep fusion framework designed to predict disease severity at multiple time points from unstructured notes, generating comprehensive disease trajectories. The framework allows clinicians to visualize disease progression, uncovering key patterns, biomarkers, and factors driving transitions, with initial application to sepsis.},
booktitle = {Companion Proceedings of the 30th International Conference on Intelligent User Interfaces},
pages = {1–4},
numpages = {4},
keywords = {Disease Progression, Large Language Model, Autoencoder, Time series prediction, Sepsis},
location = {Cagliari, Italy},
series = {IUI '25 Companion}
}

@inproceedings{10.1145/3799682.3840974,
author = {Bellini, Matteo and Bombarda, Andrea and Cazzaniga, Paolo and Iascone, Maria and Sabaini, Leonardo and Savo, Domenico Fabio},
title = {PHASE: A Modular LLM Pipeline for On-Premise Phenotype Profile Extraction from Clinical Referral Reports},
year = {2026},
isbn = {9798400725395},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3799682.3840974},
doi = {10.1145/3799682.3840974},
abstract = {The automated extraction of structured phenotypic profiles from clinical narratives is a critical step in genetic diagnosis, but it is hindered by the unstructured nature of medical reports, the contextual complexity of clinical language, and strict privacy requirements that forbid sending clinical data to external services. We present PHASE, a modular pipeline for the extraction of phenotypic profiles from clinical referral reports, designed to work under on-premise deployment constraints. Instead of using a single Large Language Model (LLM) monolithically, PHASE decomposes the task across specialized modules that interleave generative reasoning with explicit ontological alignment: a high-recall semantic extractor, a hybrid ontological aligner against the Human Phenotype Ontology (HPO), a generative concept normalizer, and an ontology-grounded validator. The resulting phenotypic profile consists of records that link each phenotype to its HPO concept, identify its subject (proband or family member) and assertion status (confirmed, negated, or suspected), and provide a natural-language rationale supporting the prediction. We further propose an ontology-aware evaluation metric that complements strict identifier matching with bounded partial credit based on HPO topology. We evaluate PHASE on a public dataset of clinical case reports, against five state-of-the-art systems, and show consistent improvements in precision, recall, and F1 score under both exact-match and ontology-aware metrics, while operating exclusively on quantized LLMs deployable on a single workstation GPU. An ablation study quantifies the antagonistic and complementary contributions of generative normalization (recall amplifier) and ontology-grounded validation (precision filter), with consistent qualitative behavior across two open-weight LLMs.},
booktitle = {Proceedings of the 35th ACM International Conference on Information and Knowledge Management},
pages = {295–306},
numpages = {12},
keywords = {clinical nlp, clinical information extraction, concept normalization, human phenotype ontology, on-premises llm deployment},
location = {Rome, Italy},
series = {CIKM '26}
}

@inproceedings{10.1145/3746252.3760894,
author = {Li, Rumeng and Wang, Xun and Yu, Hong},
title = {Improving Rare and Common ICD Coding via a Multi-Agent LLM-Based Approach},
year = {2025},
isbn = {9798400720406},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3746252.3760894},
doi = {10.1145/3746252.3760894},
abstract = {Large Language Models (LLMs) have shown strong performance in tasks such as zero- and few-shot information extraction from clinical text without domain-specific training. However, in the ICD coding task, LLMs often hallucinate key details and produce high-recall but low-precision outputs due to the high-dimensional and imbalanced nature of ICD code distributions. Existing LLM-based approaches typically fail to capture the complex, dynamic interactions among human agents involved in real-world coding workflows-such as patients, physicians, and coders-and often lack interpretability and reliability. To address these challenges, we propose a novel multi-agent framework for ICD coding that simulates the real-world process using five role-specific LLM agents-patient, physician, coder, reviewer, and adjuster-and integrates the Subjective, Objective, Assessment, and Plan (SOAP) structure from Electronic Health Records to enhance performance. Evaluated on the MIMIC-III dataset, our method significantly outperforms zero-shot Chain-of-Thought prompting, self-consistency strategies, and LLM-designed agent baselines, particularly for rare codes. Ablation studies confirm the contribution of each agent role, and the system achieves competitive performance with state-of-the-art fine-tuned models, while offering better explainability and requiring no task-specific pre-training.},
booktitle = {Proceedings of the 34th ACM International Conference on Information and Knowledge Management},
pages = {4945–4949},
numpages = {5},
keywords = {icd coding, llm, multi-agent system, prompting},
location = {Seoul, Republic of Korea},
series = {CIKM '25}
}

@inproceedings{10.1145/3706599.3720208,
author = {Krishnamoorthy Srinivasan, Shyama Sastha and Bahadur, Arhaan and Singh, Suruchi and Kedia gupta, Swati and Jain, Vanya and Deb, Koushik Sinha and Kumar, Mohan and Singh, Pushpendra},
title = {Demystifying Mental Health Reports Through an LLM-based Approach},
year = {2025},
isbn = {9798400713958},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3706599.3720208},
doi = {10.1145/3706599.3720208},
abstract = {Medical diagnoses typically contain strong jargon that is inaccessible to people with lower health literacy. Mental health is one such domain where comprehensibility is exacerbated further. Even with increasing awareness about mental health, support from practitioners or authentic knowledge sources is required to understand diagnostic information. Through this work, we utilize locally trained and finetuned Large Language Models (LLMs) to examine comprehension improvement of mental health diagnostic reports. Through a survey (n=105) with participants over 18 and a demonstration to practicing professionals, we examine the outputs of our AI-driven approach. Our approach offers two key benefits: (1) it simplifies complex psychiatric information for laypersons, providing understandable explanations; (2) it enables doctors to access concise summaries and information via tailored retrieval techniques. We outline this tool’s development, explain the methodology, evaluate its potential for information gain and healthcare delivery, and propose directions for future research.},
booktitle = {Proceedings of the Extended Abstracts of the CHI Conference on Human Factors in Computing Systems},
articleno = {174},
numpages = {7},
keywords = {Health Informatics, Information Extraction, Medical Records Informatics},
location = {Yokohama, Japan},
series = {CHI EA '25}
}

@inproceedings{10.1145/3593013.3593982,
author = {Xiao, Yuxin and Lim, Shulammite and Pollard, Tom Joseph and Ghassemi, Marzyeh},
title = {In the Name of Fairness: Assessing the Bias in Clinical Record De-identification},
year = {2023},
isbn = {9798400701924},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3593013.3593982},
doi = {10.1145/3593013.3593982},
abstract = {Data sharing is crucial for open science and reproducible research, but the legal sharing of clinical data requires the removal of protected health information from electronic health records. This process, known as de-identification, is often achieved through the use of machine learning algorithms by many commercial and open-source systems. While these systems have shown compelling results on average, the variation in their performance across different demographic groups has not been thoroughly examined. In this work, we investigate the bias of de-identification systems on names in clinical notes via a large-scale empirical analysis. To achieve this, we create 16 name sets that vary along four demographic dimensions: gender, race, name popularity, and the decade of popularity. We insert these names into 100 manually curated clinical templates and evaluate the performance of nine public and private de-identification methods. Our findings reveal that there are statistically significant performance gaps along a majority of the demographic dimensions in most methods. We further illustrate that de-identification quality is affected by polysemy in names, gender context, and clinical note characteristics. To mitigate the identified gaps, we propose a simple and method-agnostic solution by fine-tuning de-identification methods with clinical context and diverse names. Overall, it is imperative to address the bias in existing methods immediately so that downstream stakeholders can build high-quality systems to serve all demographic parties fairly.},
booktitle = {Proceedings of the 2023 ACM Conference on Fairness, Accountability, and Transparency},
pages = {123–137},
numpages = {15},
keywords = {Clinical De-identification, Fairness, Named Entity Recognition},
location = {Chicago, IL, USA},
series = {FAccT '23}
}

